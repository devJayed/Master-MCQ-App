PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/mcq-master
# Comma-separated browser origins allowed by CORS.
CLIENT_URL=http://localhost:3000,https://master-mcq-app-web.vercel.app
# Generate a unique value with at least 32 random characters. Never commit the real value.
JWT_ACCESS_SECRET=replace-with-a-different-long-random-secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM="MCQ Master <no-reply@example.com>"
TRANSLATION_PROVIDER=mymemory
TRANSLATION_API_URL=https://api.mymemory.translated.net/get
